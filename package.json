{
  "name": "helix-monorepo",
  "private": true,
  "workspaces": [
    "multi-agent-orchestrator",
    "apps/lead-scoring",
    "apps/legal",
    "apps/inbox",
    "apps/commerce",
    "apps/marketing",
    "apps/real-estate",
    "apps/social-media",
    "packages/helix-core",
    "packages/helix-help",
    "packages/helix-ui"
  ],
  "scripts": {
    "dev:core": "npm run dev --workspace=helix-orchestrator",
    "dev:leads": "npm run dev --workspace=helix-lead-scoring",
    "dev:legal": "npm run dev --workspace=helix-legal",
    "dev:inbox": "npm run dev --workspace=helix-inbox",
    "dev:commerce": "npm run dev --workspace=helix-commerce",
    "dev:marketing": "npm run dev --workspace=helix-marketing",
    "test": "npm test --workspace=@helix/core",
    "dev:realestate": "npm run dev --workspace=helix-real-estate",
    "dev:social": "npm run dev --workspace=helix-social-media"
  },
  "devDependencies": {
    "@playwright/test": "^1.62.1",
    "playwright": "^1.62.1"
  }
}
