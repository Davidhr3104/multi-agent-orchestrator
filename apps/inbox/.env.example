# Helix for Inbox — local
# Ports: Commerce :43150 (Claude Code) · Inbox :43151

HELIX_LEADS_URL=http://localhost:43148
HELIX_LEGAL_URL=http://localhost:43149
HELIX_COMMERCE_URL=http://localhost:43150
HELIX_INBOX_URL=http://localhost:43151
HELIX_OPERATOR_KEY=
# demo = auto-load Northwind samples. Unset = start empty.
HELIX_DESK_SEED=

# Same Supabase project as Leads/Legal.
# Run apps/inbox/supabase/full-schema.sql and expose schema `inbox`.
ANTHROPIC_API_KEY=
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=
RESEND_API_KEY=
RESEND_FROM=
GMAIL_ACCESS_TOKEN=

# Google OAuth (Gmail read/send + Calendar read-only). Redirect URI: <origin>/api/auth/gmail/callback
# Scopes requested: gmail.modify + calendar.events.readonly. Reconnect after enabling Calendar.
GOOGLE_OAUTH_CLIENT_ID=
GOOGLE_OAUTH_CLIENT_SECRET=
# Optional: zone for free-slot search when Google does not report one (default America/Mexico_City).
HELIX_INBOX_TIMEZONE=

# Calendly personal access token (read-only agenda).
CALENDLY_TOKEN=

# Twilio SMS / WhatsApp. Every send needs a human confirmation. TWILIO_FROM in E.164 (+1555...).
# For WhatsApp, TWILIO_FROM must be a WhatsApp-enabled sender (or the Twilio sandbox number).
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM=

# Protects /api/cron/triage and the weekly report cron. Vercel Cron sends it as a Bearer token.
CRON_SECRET=
