# Optional. Heuristic scoring + in-memory store work without these.
# With URL + service role: RFPs + audit persist in schema `legal`
# (run apps/legal/supabase/rfps-audit.sql and expose schema `legal` in API settings).

ANTHROPIC_API_KEY=
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=
HELIX_LEADS_URL=http://localhost:43148
HELIX_LEGAL_URL=http://localhost:43149
# Ops-only product switcher. Leave empty on customer deploys.
HELIX_OPERATOR_KEY=
# demo = auto-load 4 sample RFPs. Unset = start empty.
HELIX_DESK_SEED=
# SAM.gov public API key (sam.gov → Account Details → API Key). Enables "Import from SAM.gov" and the daily sync.
SAM_GOV_API_KEY=
# Any long random string. Vercel Cron sends it as a Bearer token to /api/cron/sam-sync; unset = sync disabled.
CRON_SECRET=
