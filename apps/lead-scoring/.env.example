# Optional. Heuristic scoring + in-memory store work without these.

# Claude triage (cheap model) + next-best-move drafts. Without it: heuristic triage, no AI drafts.
ANTHROPIC_API_KEY=
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
GHL_API_KEY=
GHL_LOCATION_ID=
# HubSpot private app token (scope crm.objects.contacts.write). Pushes only on human approval.
HUBSPOT_TOKEN=
# Single-tenant only: secret path segment for POST /api/leads/intake/<token>.
# With Supabase orgs, use the org webhook token instead.
HELIX_INTAKE_TOKEN=
# Protects /api/cron/triage. Vercel Cron sends it as "Authorization: Bearer <CRON_SECRET>".
CRON_SECRET=
SLACK_WEBHOOK_URL=
CALENDLY_URL=
HELIX_PUBLIC_URL=http://localhost:43148
# demo = auto-load sample leads. Unset = start empty (Settings → Load demo catalog).
HELIX_DESK_SEED=
HELIX_OPERATOR_KEY=
# Optional BuiltWith key is unused unless you add a live enricher later.
BUILTWITH_API_KEY=
