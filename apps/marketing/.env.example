# Optional. Without it the waste report is the deterministic analysis (labelled "no AI").
ANTHROPIC_API_KEY=

# Optional. Same Supabase project as other Helix desks. Apply supabase/schemas/marketing.sql.
# NEXT_PUBLIC_SUPABASE_URL=
# SUPABASE_SERVICE_ROLE_KEY=

# Meta Ads: Insights read + HITL pause/scale write-back (token needs ads_read + ads_management).
# META_ACCESS_TOKEN=
# META_AD_ACCOUNT_ID=

# Google Ads (read-only spend). All five required; LOGIN_CUSTOMER_ID only when access goes through an MCC.
# GOOGLE_ADS_DEVELOPER_TOKEN=
# GOOGLE_ADS_CLIENT_ID=
# GOOGLE_ADS_CLIENT_SECRET=
# GOOGLE_ADS_REFRESH_TOKEN=
# GOOGLE_ADS_CUSTOMER_ID=
# GOOGLE_ADS_LOGIN_CUSTOMER_ID=
# GOOGLE_ADS_API_VERSION=v22

# TikTok Ads (read-only spend) — Business API long-lived access token + advertiser id.
# TIKTOK_ADS_ACCESS_TOKEN=
# TIKTOK_ADS_ADVERTISER_ID=

# Daily refresh cron (/api/cron/marketing-refresh). Required: without it the job refuses to run.
# CRON_SECRET=
# Optional Slack alert from the cron, and the link it includes.
# SLACK_WEBHOOK_URL=
# HELIX_MARKETING_URL=https://helix-for-marketing.vercel.app

# demo = auto-load Ad A–E. Unset or empty = start empty (Settings → Load demo catalog).
HELIX_DESK_SEED=
# Live scored leads: Marketing POSTs /api/leads/sync to this URL (default localhost:43148).
HELIX_LEADS_URL=http://127.0.0.1:43148
