{
  "framework": "nextjs",
  "installCommand": "npm install",
  "buildCommand": "npm run build --workspace=helix-commerce",
  "outputDirectory": ".next",
  "crons": [
    {
      "path": "/api/daily-brief",
      "schedule": "0 13 * * *"
    },
    {
      "path": "/api/cron/poll-orders",
      "schedule": "30 12 * * *"
    }
  ]
}
