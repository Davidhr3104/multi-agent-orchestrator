# Optional. Placeholder scaffold — no external services wired yet.

ANTHROPIC_API_KEY=
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=
# demo = auto-load mock Shopify catalog. Unset = start empty.
HELIX_DESK_SEED=
SHOPIFY_STORE_DOMAIN=
SHOPIFY_ACCESS_TOKEN=
# Shopify webhook signing secret (Settings > Notifications > Webhooks). Required for /api/webhooks/shopify.
SHOPIFY_WEBHOOK_SECRET=
# Required for /api/cron/poll-orders (fails closed without it). Vercel Cron sends it as a Bearer token.
CRON_SECRET=
# Optional: hours of orders the daily poll re-reads from Shopify (default 26).
CRON_LOOKBACK_HOURS=
# Optional: Slack incoming webhook for the daily brief and new-order alerts.
SLACK_WEBHOOK_URL=
# Optional: public URL of this desk, used for the review link in Slack alerts.
HELIX_COMMERCE_URL=
